/-- Inside the set every amplitude is at most `7` in absolute value: `E ≤ 9` gives
`a_k² ≤ 9 λ_k ≤ 45 < 49`. -/
theorem tube_boxed (x : Point 3) (hx : tubeV x ≤ 1) : ∀ i, |x i - (0 : Point 3) i| ≤ 7 := by
  have h := tube_contained x hx
  unfold energy at h
  intro i
  rw [Pi.zero_apply, sub_zero, abs_le]
  fin_cases i <;> simp <;> constructor <;> nlinarith [sq_nonneg (x 0), sq_nonneg (x 1), sq_nonneg (x 2)]

/-! ## The trapping data and the contract -/

/-- The tube: `V ≤ 1`, rate `α`, inner level `β/α < 1`, inside the box of radius `7`
about the origin. -/
noncomputable def below9 : Nonlinear.PolynomialTrapping 3 where
  poly := tubeExpr
  centre := 0
  alpha := (247613 / 10000 : ℝ)
  inner := (247603 / 247613 : ℝ)
  bound := 1
  radius := 7
  radius_nonneg := by norm_num
  alpha_pos := by norm_num
  margin := by norm_num
  boxed := fun x hx => tube_boxed x (by rwa [tubeExpr_eval] at hx)

theorem energy_eq_below9 (x : Point 3) : below9.energy x = tubeV x := by
  simp only [below9, Nonlinear.PolynomialTrapping.energy]; exact tubeExpr_eval x

theorem rate_eq_below9 (x : Point 3) : below9.rate (Nonlinear.field compiled) x = tubeVdot x := by
  rw [field_eq, tubeVdot_eq]
  simp only [below9, Nonlinear.PolynomialTrapping.rate, Fin.sum_univ_three]
  rw [tube_diff_eval0, tube_diff_eval1, tube_diff_eval2]
  simp [field]

theorem decreases_below9 : below9.Decreases (Nonlinear.field compiled) := by
  intro x hx
  rw [energy_eq_below9] at hx
  rw [rate_eq_below9, energy_eq_below9]
  exact tube_decrease_on_set x hx

theorem initial_below9 : below9.energy compiled.initial ≤ below9.bound := by
  rw [energy_eq_below9, initial_eq]
  simp [tubeV, Matrix.cons_val, below9]; norm_num

/-- Every realization keeps the energy observation in `[0, 9]`. -/
theorem energy_le_nine (state : Dynamics.Signal 3) (realized : compiled.Realizes state) :
    ∀ t ∈ evolution.time.domain,
      0 ≤ compiled.outputs.circuit.run (state t) energyIndex ∧
        compiled.outputs.circuit.run (state t) energyIndex ≤ 9 := by
  intro t ht
  have inv : below9.energy (state t) ≤ 1 :=
    Nonlinear.poly_compiled_invariant compiled below9 decreases_below9 initial_below9 state realized t ht
  rw [energy_eq_below9] at inv
  rw [energy_at]
  refine ⟨?_, tube_contained _ inv⟩
  rw [energy_eq_trapping]
  exact trapping.energy_nonneg _

/-- **The contract below the laminar level**: `0 ≤ E ≤ 9` for all time, for every
admitted input. -/
theorem below9_contract :
    Contract observed evolution.time admitted
      (Always evolution.time fun observation =>
        0 ≤ observation energyIndex ∧ observation energyIndex ≤ 9) :=
  Nonlinear.poly_bounded_contract compiled below9 energyIndex 0 9 decreases_below9
    initial_below9 energy_le_nine

/-- The laminar equilibrium `(0, 5, 0)` (`laminar_equilibrium`) lies outside the set; the start lies inside. -/
theorem tube_laminar_outside : 1 < tubeV ![0, 5, 0] := by
  simp [tubeV, Matrix.cons_val]; norm_num

theorem tube_start_inside : tubeV ![1, 1, 1] < 1 := by
  simp [tubeV, Matrix.cons_val]; norm_num

#print axioms below9_contract

end Gimle.Forseti.Examples.GalerkinNS.T3
