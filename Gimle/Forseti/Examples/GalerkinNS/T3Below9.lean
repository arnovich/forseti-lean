/-- The decrease on the set, in closed form: `V ≤ 1 → V' ≤ α (inner − V)`. -/
theorem tube_decrease_on_set (x : Point 3) (hx : tubeV x ≤ 1) :
    tubeVdot x ≤ (247613 / 10000 : ℝ) * ((247603 / 247613 : ℝ) - tubeV x) := by
  have key : 0 ≤ (247603 / 10000 : ℝ) - (247613 / 10000 : ℝ) * tubeV x - tubeVdot x + tubeSigma x * (tubeV x - 1) := by
    rw [tube_certificate_sos]; exact tube_sos_nonneg x
  have hs : tubeSigma x * (tubeV x - 1) ≤ 0 :=
    mul_nonpos_of_nonneg_of_nonpos (tubeSigma_nonneg x) (by linarith)
  linarith [key, hs]

