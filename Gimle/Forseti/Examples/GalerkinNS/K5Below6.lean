/-- The decrease on the set, in closed form: `V ≤ 1 → V' ≤ α (inner − V)`. -/
theorem decrease_on_set (x : Point 5) (hx : V x ≤ 1) :
    Vdot x ≤ (237921 / 10000 : ℝ) * ((237911 / 237921 : ℝ) - V x) := by
  have key : 0 ≤ (237911 / 10000 : ℝ) - (237921 / 10000 : ℝ) * V x - Vdot x + sigma x * (V x - 1) := by
    rw [certificate_sos]; exact sos_nonneg x
  have hs : sigma x * (V x - 1) ≤ 0 :=
    mul_nonpos_of_nonneg_of_nonpos (sigma_nonneg x) (by linarith)
  linarith [key, hs]

