/-- Inside the set every amplitude is at most `6` in absolute value: `E ≤ 6` gives
`a_k² ≤ 6 λ_k ≤ 30 < 36`. -/
theorem boxed (x : Point 5) (hx : V x ≤ 1) : ∀ i, |x i - (0 : Point 5) i| ≤ 6 := by
  have h := contained x hx
  unfold energy at h
  intro i
  rw [Pi.zero_apply, sub_zero, abs_le]
  fin_cases i <;> simp <;> constructor <;> nlinarith [sq_nonneg (x 0), sq_nonneg (x 1), sq_nonneg (x 2), sq_nonneg (x 3), sq_nonneg (x 4)]

/-! ## The trapping data and the contract -/

/-- The tube: `V ≤ 1`, rate `α`, inner level `β/α < 1`, inside the box of radius `6`
about the origin. -/
noncomputable def below6 : Nonlinear.PolynomialTrapping 5 where
  poly := tubeExpr
  centre := 0
  alpha := (237921 / 10000 : ℝ)
  inner := (237911 / 237921 : ℝ)
  bound := 1
  radius := 6
  radius_nonneg := by norm_num
  alpha_pos := by norm_num
  margin := by norm_num
  boxed := fun x hx => boxed x (by rwa [tubeExpr_eval] at hx)

theorem energy_eq_below6 (x : Point 5) : below6.energy x = V x := by
  simp only [below6, Nonlinear.PolynomialTrapping.energy]; exact tubeExpr_eval x

theorem rate_eq_below6 (x : Point 5) : below6.rate (Nonlinear.field compiled) x = Vdot x := by
  rw [field_eq, Vdot_eq]
  simp only [below6, Nonlinear.PolynomialTrapping.rate, Fin.sum_univ_five]
  rw [diff_eval0, diff_eval1, diff_eval2, diff_eval3, diff_eval4]
  simp [field]

theorem decreases_below6 : below6.Decreases (Nonlinear.field compiled) := by
  intro x hx
  rw [energy_eq_below6] at hx
  rw [rate_eq_below6, energy_eq_below6]
  exact decrease_on_set x hx

theorem initial_below6 : below6.energy compiled.initial ≤ below6.bound := by
  rw [energy_eq_below6, initial_eq]
  simp [V, Matrix.cons_val, below6]; norm_num

/-- Every realization keeps the energy observation in `[0, 6]`. -/
theorem energy_le_six (state : Dynamics.Signal 5) (realized : compiled.Realizes state) :
    ∀ t ∈ evolution.time.domain,
      0 ≤ compiled.outputs.circuit.run (state t) energyIndex ∧
        compiled.outputs.circuit.run (state t) energyIndex ≤ 6 := by
  intro t ht
  have inv : below6.energy (state t) ≤ 1 :=
    Nonlinear.poly_compiled_invariant compiled below6 decreases_below6 initial_below6 state realized t ht
  rw [energy_eq_below6] at inv
  rw [energy_at]
  refine ⟨?_, contained _ inv⟩
  rw [energy_eq_trapping]
  exact trapping.energy_nonneg _

/-- **The contract below the laminar level**: `0 ≤ E ≤ 6` for all time, for every
admitted input. -/
theorem below6_contract :
    Contract observed evolution.time admitted
      (Always evolution.time fun observation =>
        0 ≤ observation energyIndex ∧ observation energyIndex ≤ 6) :=
  Nonlinear.poly_bounded_contract compiled below6 energyIndex 0 6 decreases_below6
    initial_below6 energy_le_six

/-- `(0, 0, 5, 0, 0)` is the laminar equilibrium of the field, and it lies outside the set;
the start lies inside. -/
theorem laminar_equilibrium : field ![0, 0, 5, 0, 0] = 0 := by
  ext i; fin_cases i <;> simp [field, Matrix.cons_val]

theorem laminar_outside : 1 < V ![0, 0, 5, 0, 0] := by
  simp [V, Matrix.cons_val]; norm_num

theorem start_inside : V ![1, 1, 1, 1, 1] < 1 := by
  simp [V, Matrix.cons_val]; norm_num

#print axioms below6_contract

end Gimle.Forseti.Examples.GalerkinNS.K5
