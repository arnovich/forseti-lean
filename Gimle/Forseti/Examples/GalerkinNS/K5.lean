theorem initial_eq : compiled.initial = (![1, 1, 1, 1, 1] : Point 5) := by
  change (fun i : Fin 5 => (compiled.initials i : ℝ)) = _
  have values : compiled.initials = ![1, 1, 1, 1, 1] := by decide +kernel
  rw [values]
  ext i
  fin_cases i <;> norm_num

/-- The field in closed form, in state order. -/
noncomputable def field (x : Point 5) : Point 5 :=
  ![(-1 / 10 : ℝ) * x 0 + (-3 / 20 : ℝ) * x 2 * x 3 + (-1 / 4 : ℝ) * x 1 * x 2,
    (-1 / 10 : ℝ) * x 1 + (3 / 20 : ℝ) * x 2 * x 4 + (1 / 4 : ℝ) * x 0 * x 2,
    (1 / 1 : ℝ) + (-1 / 5 : ℝ) * x 2 + (-2 / 5 : ℝ) * x 1 * x 4 + (2 / 5 : ℝ) * x 0 * x 3,
    (-1 / 2 : ℝ) * x 3 + (-1 / 4 : ℝ) * x 0 * x 2,
    (-1 / 2 : ℝ) * x 4 + (1 / 4 : ℝ) * x 1 * x 2]

theorem rates_formula (x : Point 5) : compiled.rates.circuit.run x = field x := by
  rw [Selected.circuit, compileOutputs_correct, rates_expressions]
  ext i
  change Fin 5 at i
  fin_cases i <;> simp [field, Expr.eval] <;> ring

theorem rates_eval (i : Fin evolution.states.length) (x : Point evolution.states.length) :
    (compiled.rates.expressions i).eval x = field x i := by
  have h := congrFun (rates_formula x) i
  rwa [Selected.circuit, compileOutputs_correct] at h

theorem field_eq : Nonlinear.field compiled = field := by
  funext x i
  exact rates_eval i x

