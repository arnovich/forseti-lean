import Gimle.Forseti.Nonlinear
import Gimle.Forseti.GalerkinNS.Family
import Gimle.Asgard.Compile.Syntax

/-! # K5: a Galerkin truncation of 2D Navier–Stokes, trapped

Generated by tools/galerkin_ns.py; do not edit by hand. Every identity below
was checked by exact polynomial expansion before it was written, and is
checked again here by Lean.

Modes: a10 = (1, 0), a01 = (0, 1), a11 = (1, 1), a21 = (2, 1), a12 = (1, 2).
ν = 1/10, f = 1 on cos(x + y). Energy E = Σ a_k²/|k|²;
E' ≤ 2ν (f²/(8ν²) − E) = 1/5 · (25/2 − E), and the trapped level is
13 > 25/2, from the start (1, …, 1). Enstrophy Z = Σ a_k²;
Z' ≤ 2ν (f²/(4ν²) − Z) = 1/5 · (25 − Z), and the trapped level is
26 > 25. Unforced energy E_rest = Σ_{k ≠ (1,1)} a_k²/|k|²; the forced
mode's coupling sum is K = 4/5, so with r = 6 the rate
2ν − K r = -23/5 is not positive: no decay is claimed. -/

namespace Gimle.Forseti.Examples.GalerkinNS.K5

open Gimle.Forseti
open Gimle.Forseti.Trajectory
open Gimle.Asgard Gimle.Asgard.Model Gimle.Asgard.Polynomial

set_option maxRecDepth 4000
-- Generated tactic chains use `<;>` so that a `simp` closing a goal early is
-- not an error; the linters that flag that are off for this file.
set_option linter.unnecessarySeqFocus false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

/-- The modes as states, the forced mode's equation carrying `f`, and the
energy, the enstrophy and the unforced energy as the last three observations. -/
def body : Body := {
  program := ⟨[⟨"state-a10", "a10", .state⟩, ⟨"state-a01", "a01", .state⟩, ⟨"state-a11", "a11", .state⟩, ⟨"state-a21", "a21", .state⟩, ⟨"state-a12", "a12", .state⟩],
    equations% {
      da10 := (-rat(1,10)) * a10 + (-rat(3,20)) * a11 * a21 + (-rat(1,4)) * a01 * a11;
      da01 := (-rat(1,10)) * a01 + rat(3,20) * a11 * a12 + rat(1,4) * a10 * a11;
      da11 := rat(1,1) + (-rat(1,5)) * a11 + (-rat(2,5)) * a01 * a12 + rat(2,5) * a10 * a21;
      da21 := (-rat(1,2)) * a21 + (-rat(1,4)) * a10 * a11;
      da12 := (-rat(1,2)) * a12 + rat(1,4) * a01 * a11;
      E := rat(1,1) * a10 * a10 + rat(1,1) * a01 * a01 + rat(1,2) * a11 * a11 + rat(1,5) * a21 * a21 + rat(1,5) * a12 * a12;
      Z := rat(1,1) * a10 * a10 + rat(1,1) * a01 * a01 + rat(1,1) * a11 * a11 + rat(1,1) * a21 * a21 + rat(1,1) * a12 * a12;
      R := rat(1,1) * a10 * a10 + rat(1,1) * a01 * a01 + rat(1,5) * a21 * a21 + rat(1,5) * a12 * a12;
    }⟩
  observations := [⟨⟨"obs-a10", "a10", .output⟩, "state-a10"⟩, ⟨⟨"obs-a01", "a01", .output⟩, "state-a01"⟩, ⟨⟨"obs-a11", "a11", .output⟩, "state-a11"⟩, ⟨⟨"obs-a21", "a21", .output⟩, "state-a21"⟩, ⟨⟨"obs-a12", "a12", .output⟩, "state-a12"⟩, ⟨⟨"obs-e", "E", .output⟩, "E"⟩, ⟨⟨"obs-z", "Z", .output⟩, "Z"⟩, ⟨⟨"obs-r", "R", .output⟩, "R"⟩]
}

/-- From `(1, …, 1)` at `t = 0`. -/
def evolution : Evolution := {
  states := [⟨"state-a10", "da10", "initial-a10"⟩, ⟨"state-a01", "da01", "initial-a01"⟩, ⟨"state-a11", "da11", "initial-a11"⟩, ⟨"state-a21", "da21", "initial-a21"⟩, ⟨"state-a12", "da12", "initial-a12"⟩]
  initialPorts := [⟨"initial-a10", "a10_0", .initial⟩, ⟨"initial-a01", "a01_0", .initial⟩, ⟨"initial-a11", "a11_0", .initial⟩, ⟨"initial-a21", "a21_0", .initial⟩, ⟨"initial-a12", "a12_0", .initial⟩]
  initialValues := [⟨"initial-a10", 1⟩, ⟨"initial-a01", 1⟩, ⟨"initial-a11", 1⟩, ⟨"initial-a21", 1⟩, ⟨"initial-a12", 1⟩]
  axis := ⟨"time", "t"⟩
