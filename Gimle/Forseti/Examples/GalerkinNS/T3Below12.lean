/-- Every realization keeps the energy observation in `[0, 12]`. -/
theorem energy_le_twelve (state : Dynamics.Signal 3) (realized : compiled.Realizes state) :
    ∀ t ∈ evolution.time.domain,
      0 ≤ compiled.outputs.circuit.run (state t) energyIndex ∧
        compiled.outputs.circuit.run (state t) energyIndex ≤ 12 := by
  intro t ht
  have inv : below12.energy (state t) ≤ 1 :=
    Nonlinear.local_compiled_invariant compiled below12 decreases_below12
      initial_below12 state realized t ht
  rw [energy_eq_below12] at inv
  rw [energy_at]
  refine ⟨?_, contained _ inv⟩
  rw [energy_eq_trapping]
  exact trapping.energy_nonneg _

/-- **The contract below the laminar level**: `0 ≤ E ≤ 12` for all time, for
every admitted input. -/
theorem below12_contract :
    Contract observed evolution.time admitted
      (Always evolution.time fun observation =>
        0 ≤ observation energyIndex ∧ observation energyIndex ≤ 12) :=
  Nonlinear.local_bounded_contract compiled below12 energyIndex 0 12 decreases_below12
    initial_below12 energy_le_twelve

/-- `(0, 5, 0)` is the laminar equilibrium of the field. -/
theorem laminar_equilibrium : field ![0, 5, 0] = 0 := by
  ext i; fin_cases i <;> simp [field, Matrix.cons_val]

/-- The laminar equilibrium is outside the set, and the start inside: under a
global decrease no trapped set could exclude an equilibrium. -/
theorem laminar_outside : 1 < V ![0, 5, 0] := by
  simp [V, Matrix.cons_val]; norm_num

theorem start_inside : V ![1, 1, 1] < 1 := by
  simp [V, Matrix.cons_val]; norm_num

#print axioms below12_contract

end Gimle.Forseti.Examples.GalerkinNS.T3
