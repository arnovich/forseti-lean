/-- The decrease on the set: `V ≤ 1 → V' ≤ α (inner − V)`. -/
theorem decreases_below12 : below12.Decreases (Nonlinear.field compiled) := by
  intro x hx
  have hb : below12.bound = 1 := rfl
  rw [energy_eq_below12, hb] at hx
  rw [rate_eq_below12, energy_eq_below12]
  have h := certificate_sos x
