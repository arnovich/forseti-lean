theorem initial_below12 : below12.energy compiled.initial ≤ below12.bound := by
  rw [energy_eq_below12, initial_eq]
  simp [V, Matrix.cons_val, below12]; norm_num

/-! ## Containment in `E ≤ 12`, and the contract -/

/-- `12 − E − τ (1 − V)` is a sum of squares, so `V ≤ 1 → E ≤ 12`. -/
