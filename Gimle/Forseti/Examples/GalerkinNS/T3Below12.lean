  have key : (12 : ℝ) - energy x - (6 : ℝ) * (1 - V x) = (3382976182418669829 / 125000000000000000 : ℝ) * ((1 : ℝ) * (1 : ℝ) + (-368057974679000000 / 1127658727472889943 : ℝ) * x 0 + (-171151961279500000 / 1127658727472889943 : ℝ) * x 1 + (-33687044042000000 / 1127658727472889943 : ℝ) * x 2) ^ 2 + (65557614504496495910209 / 563829363736444971500000 : ℝ) * ((1 : ℝ) * x 0 + (101248991354603349300825 / 65557614504496495910209 : ℝ) * x 1 + (195841744242922788399843 / 65557614504496495910209 : ℝ) * x 2) ^ 2 + (34718595090547070460948271 / 4097350906531030994388062500 : ℝ) * ((1 : ℝ) * x 1 + (28515637637918606325902763 / 34718595090547070460948271 : ℝ) * x 2) ^ 2 + (15224195070556357450511173 / 347185950905470704609482710 : ℝ) * ((1 : ℝ) * x 2) ^ 2 := by
    unfold energy V; ring
